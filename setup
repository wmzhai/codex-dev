#!/usr/bin/env bash
set -euo pipefail

PROJECT_NAME="codev"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
MANAGED_SKILLS=(codev-memorize codev-issue2task codev-taskdev codev-quickship codev-simplify codev-checkpoint codev-syncpatch)
REMOVED_MANAGED_SKILLS=(codev-gstack2task codev-checktask codev-autodev codev-automerge)
LEGACY_CODEV_SKILLS=(plantask memorize issue2task gstack2task taskdev autodev automerge checktask simplify checkpoint ships)

die() {
  echo "codev setup failed: $*" >&2
  exit 1
}

if [ $# -ne 0 ]; then
  die "no arguments supported; run setup without args to install skills for clients found in PATH (codex, grok, claude)"
fi

host_client_installed() {
  command -v "$1" >/dev/null 2>&1
}

codex_skills_dir() {
  printf '%s\n' "${HOME}/.codex/skills"
}

grok_skills_dir() {
  printf '%s\n' "${HOME}/.grok/skills"
}

claude_skills_dir() {
  printf '%s\n' "${HOME}/.claude/skills"
}

ensure_symlink_or_absent() {
  local path="$1"

  if [ -e "$path" ] && [ ! -L "$path" ]; then
    die "${path} already exists and is not a symlink"
  fi
}

is_repo_owned_link() {
  local actual="$1"
  local skill_name="$2"

  [ "$actual" = "codev/skills/${skill_name}" ] \
    || [ "$actual" = "${REPO_ROOT}/skills/${skill_name}" ] \
    || [ "$actual" = "${REPO_ROOT}" ]
}

cleanup_legacy_codev_skill() {
  local skills_dir="$1"
  local skill_name="$2"
  local path="${skills_dir}/${skill_name}"
  local actual

  if [ ! -L "$path" ]; then
    return
  fi

  actual="$(readlink "$path")"

  if is_repo_owned_link "$actual" "$skill_name"; then
    rm -f "$path"
  fi
}

cleanup_host_legacy_skills() {
  local skills_dir="$1"
  local skill_name

  for skill_name in "${LEGACY_CODEV_SKILLS[@]}"; do
    cleanup_legacy_codev_skill "$skills_dir" "$skill_name"
  done

  for skill_name in "${REMOVED_MANAGED_SKILLS[@]}"; do
    cleanup_legacy_codev_skill "$skills_dir" "$skill_name"
  done
}

install_for_codex() {
  local skills_dir skill_name

  skills_dir="$(codex_skills_dir)"

  mkdir -p "$skills_dir"

  ensure_symlink_or_absent "${skills_dir}/${PROJECT_NAME}"

  for skill_name in "${MANAGED_SKILLS[@]}"; do
    ensure_symlink_or_absent "${skills_dir}/${skill_name}"
  done

  ln -snf "$REPO_ROOT" "${skills_dir}/${PROJECT_NAME}"

  for skill_name in "${MANAGED_SKILLS[@]}"; do
    ln -snf "${PROJECT_NAME}/skills/${skill_name}" "${skills_dir}/${skill_name}"
  done

  cleanup_host_legacy_skills "$skills_dir"

  echo "codev ready for Codex."
  echo "  repo: ${REPO_ROOT}"
  echo "  skills: ${skills_dir}"
  echo "  linked: ${MANAGED_SKILLS[*]}"
}

install_direct_skill_links() {
  local skills_dir="$1"
  local host_label="$2"
  local skill_name

  mkdir -p "$skills_dir"

  for skill_name in "${MANAGED_SKILLS[@]}"; do
    ensure_symlink_or_absent "${skills_dir}/${skill_name}"
  done

  for skill_name in "${MANAGED_SKILLS[@]}"; do
    ln -snf "${REPO_ROOT}/skills/${skill_name}" "${skills_dir}/${skill_name}"
  done

  cleanup_host_legacy_skills "$skills_dir"
  cleanup_legacy_codev_skill "$skills_dir" "$PROJECT_NAME"

  echo "codev ready for ${host_label}."
  echo "  repo: ${REPO_ROOT}"
  echo "  skills: ${skills_dir}"
  echo "  linked: ${MANAGED_SKILLS[*]}"
}

install_for_grok() {
  install_direct_skill_links "$(grok_skills_dir)" "Grok"
}

install_for_claude() {
  install_direct_skill_links "$(claude_skills_dir)" "Claude Code"
}

skip_host() {
  echo "skipping $1: '$2' not found in PATH"
}

installed_any=0

if host_client_installed codex; then
  install_for_codex
  installed_any=1
else
  skip_host Codex codex
fi

if host_client_installed grok; then
  install_for_grok
  installed_any=1
else
  skip_host Grok grok
fi

if host_client_installed claude; then
  install_for_claude
  installed_any=1
else
  skip_host "Claude Code" claude
fi

if [ "$installed_any" -eq 0 ]; then
  die "no supported client found in PATH (need one of: codex, grok, claude)"
fi
